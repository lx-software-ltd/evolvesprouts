# Build-time variables for Figma token sync.
# OAuth and FIGMA_FILE_KEY are optional for local builds.
# If omitted, figma:pull will skip API sync and figma:build will use
# available local exports.

# Option A: use an already-minted OAuth access token.
FIGMA_OAUTH_ACCESS_TOKEN=

# Option B: mint an OAuth access token via refresh_token grant.
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
FIGMA_OAUTH_REFRESH_TOKEN=

FIGMA_FILE_KEY=

# Scope token extraction to a specific frame/component by name or node ID.
# Prevents picking up styles from imported libraries (e.g. Material Design
# kits) that live elsewhere in the file.
# Examples:
#   FIGMA_TOKEN_ROOT_NODE=Desktop
#   FIGMA_TOKEN_ROOT_NODE=Homepage Desktop
#   FIGMA_TOKEN_ROOT_NODE=123:456
FIGMA_TOKEN_ROOT_NODE=

# Optional overrides for input files.
# FIGMA_MDM_EXPORT_PATH=figma/mdm/exports/tokens.json
# FIGMA_VARIABLES_FILE_PATH=figma/files/variables.local.json

# Public website canonical origin used by metadata, sitemap, and robots.
# Must be an absolute origin (no path), for example: https://www.example.com
NEXT_PUBLIC_SITE_ORIGIN=

# Google Tag Manager container ID (format: GTM-XXXXXXX).
# GTM only fires on hosts listed in NEXT_PUBLIC_GTM_ALLOWED_HOSTS.
# Omit NEXT_PUBLIC_GTM_ID for local development.
NEXT_PUBLIC_GTM_ID=

# Optional comma-separated host allowlist for GTM script injection.
# Defaults to the hostname from NEXT_PUBLIC_SITE_ORIGIN.
NEXT_PUBLIC_GTM_ALLOWED_HOSTS=

# Public website API base used by public_www workflows
# (events, media request, and payment-intent).
# Use "/api" so same-origin CloudFront calls /api/v1/public/..., or an
# absolute URL whose path is /api.
NEXT_PUBLIC_API_BASE_URL=

# Optional comma-separated hostname allowlist for same-origin /api proxying
# onto /v1/public.
# Example: www.example.com,www-staging.example.com
NEXT_PUBLIC_WWW_PROXY_ALLOWED_HOSTS=

# Public website runtime API key for CRM API calls.
# This value is read client-side, so use a scoped key intended for web use.
NEXT_PUBLIC_WWW_CRM_API_KEY=

# Public website Turnstile site key used by all form submissions.
# Use Cloudflare's test site key for local development:
# 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public website base URL for asset share redirect pages.
NEXT_PUBLIC_ASSET_SHARE_BASE_URL=

# Public website FPS payment QR configuration.
NEXT_PUBLIC_FPS_MERCHANT_NAME=
NEXT_PUBLIC_FPS_MOBILE_NUMBER=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_HOLDER=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=

# Stripe publishable key for the booking modal Payment Element (card entry only).
# Staging CI prefers NEXT_PUBLIC_STAGING_STRIPE_PUBLISHABLE_KEY (GitHub staging env).
# Production promotion builds use NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY (GitHub production env).
# API Lambda uses EVOLVESPROUTS_STRIPE_SECRET_KEY plus optional staging key; see docs.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Meta Pixel ID (numeric). If unset, Meta Pixel does not load.
# Meta Pixel only fires on hosts listed in NEXT_PUBLIC_META_PIXEL_ALLOWED_HOSTS.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional comma-separated host allowlist for Meta Pixel.
# Defaults to the hostname from NEXT_PUBLIC_SITE_ORIGIN.
NEXT_PUBLIC_META_PIXEL_ALLOWED_HOSTS=

# Public website maintenance contact configuration used by deployment scripts.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Public website LocalBusiness schema/contact metadata and AR invoice PDFs
# (Admin Lambda maps the same keys from CDK parameters).
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE_NUMBER=
NEXT_PUBLIC_BUSINESS_REGISTRATION=

# Optional ISO date string for sitemap <lastmod> values.
NEXT_PUBLIC_SITEMAP_LASTMOD=
