{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "generate:phone-countries": "node ../../scripts/generate-phone-countries.mjs",
    "prebuild": "npm run generate:phone-countries && npm run generate:admin-api-types",
    "generate:admin-api-types": "openapi-typescript ../../docs/api/admin.yaml -o src/types/generated/admin-api.generated.ts",
    "check:admin-api-types": "node ./scripts/check-admin-api-types.mjs",
    "lint": "npm run check:admin-api-types && eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test:coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.2",
    "amazon-cognito-identity-js": "^6.3.22",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.17",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/google.maps": "^3.67.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "espree": "^11.2.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "vitest": {
      "vite": "$vite"
    },
    "js-yaml": "^4.3.2",
    "@redocly/openapi-core": {
      "minimatch": "5.1.8"
    },
    "flatted": "^3.4.0",
    "js-cookie": "^3.0.7",
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "minimatch@10": "11.0.4",
    "deepmerge": "4.1.2"
  },
  "allowScripts": {
    "unrs-resolver": true
  }
}
